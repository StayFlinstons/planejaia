# Copie este arquivo para ".env" e preencha.
# Estas variáveis SÃO públicas (vão para o navegador). Nunca coloque aqui a chave da IA.

# Supabase — Painel do projeto > Project Settings > API
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Endereço do back-end. Em desenvolvimento deixe vazio (o Vite redireciona /api).
# Em produção, informe a URL pública do servidor, ex.: https://planejaia-api.onrender.com
VITE_API_URL=
