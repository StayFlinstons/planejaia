# Copie este arquivo para ".env" e preencha com os seus valores.
# O arquivo .env NUNCA deve ser enviado ao GitHub.

# Porta do servidor
PORT=3001

# Endereço(s) do front-end autorizados (separe vários por vírgula)
CLIENT_ORIGIN=http://localhost:5173

# Supabase — Painel do projeto > Project Settings > API
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-publica

# Google Gemini — https://aistudio.google.com/apikey
# Esta chave fica SOMENTE no servidor. Nunca coloque no front-end.
GEMINI_API_KEY=sua-chave-do-gemini
# Modelo usado. "gemini-flash-latest" aponta sempre para o Flash mais recente.
GEMINI_MODEL=gemini-flash-latest

# Limite de pedidos ao assistente por usuário a cada 10 minutos
AI_RATE_LIMIT=20

# Modo demonstração: responde com exemplos fixos (marcados como DEMONSTRAÇÃO)
# quando não houver chave do Gemini. Deixe "false" em produção.
AI_DEMO_MODE=false
